{
  "name": "JAVISREVENGE",
  "short_name": "REVENGE",
  "description": "The Revenge Wall — Break the walls down. No limits.",
  "id": "/wall",
  "start_url": "/wall?source=app",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#000000",
  "theme_color": "#000000",
  "categories": ["social", "news"],
  "icons": [
    { "src": "/assets/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/assets/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/assets/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "New post", "url": "/wall?compose=1", "icons": [{ "src": "/assets/icon-192.png", "sizes": "192x192" }] },
    { "name": "Notifications", "url": "/wall?view=notifications", "icons": [{ "src": "/assets/icon-192.png", "sizes": "192x192" }] }
  ]
}
